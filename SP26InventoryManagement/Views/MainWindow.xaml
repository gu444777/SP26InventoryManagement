<Window x:Class="SP26InventoryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventory Management"
        Height="420"
        Width="860"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,16">

            <Button Content="Change Password"
                    Command="{Binding OpenChangePasswordCommand}"
                    MinWidth="150"
                    Padding="10,6"
                    Margin="0,0,8,0" />
            <Button Content="Logout"
                    Command="{Binding LogoutCommand}"
                    MinWidth="110"
                    Padding="10,6" />
        </StackPanel>


        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Inventory Management"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Text="{Binding FullName, StringFormat='Signed in as: {0}'}"
                               FontSize="16"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Username, StringFormat='Username: {0}'}"
                               FontSize="14"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RolesDisplay, StringFormat='Roles: {0}'}"
                               FontSize="14" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Open Modules"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <WrapPanel>

                        <Button Content="Manage Customers"
            Width="160"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanManageMasterData, Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding OpenManageCustomersCommand}" />

                        <Button Content="Manage Suppliers"
            Width="160"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanManageMasterData, Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding OpenManageSuppliersCommand}" />

                        <Button Content="Manage User"
            Width="150"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenManageUserButton_OnClick" />

                        <Button Content="Open Issue (Staff)"
            Width="170"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanOpenIssueStaff, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenIssueStaffButton_OnClick" />

                        <Button Content="Open Issue (Manager)"
            Width="190"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanOpenIssueManager, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenIssueManagerButton_OnClick" />
            <Button Content="Open Transfer"
                                Width="150"
                                Height="38"


                                Margin="0,0,10,10"
                                Visibility="{Binding CanManageUsers, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OpenManageUserButton_OnClick" />

                        <Button Content="Manage Warehouses"
                                Width="160"
                                Height="38"
                                Margin="0,0,10,10"
                                Command="{Binding OpenWarehouseCommand}"
                                Visibility="{Binding CanManageWarehouses, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Manage Categories"
        Width="160"
        Height="38"
        Margin="0,0,10,10"
        Command="{Binding OpenManageCategoriesCommand}"
        Visibility="{Binding CanManageProducts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Manage Products"
        Width="160"
        Height="38"
        Margin="0,0,10,10"
        Command="{Binding OpenManageProductsCommand}"
        Visibility="{Binding CanManageProducts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Stock Adjustment" 
        Width="160" Height="38" Margin="0,0,10,10"
        Command="{Binding OpenAdjustmentCommand}" />
                        <Button Content="Open Issue (Staff)"
                                Width="170"
                                Height="38"
                                Margin="0,0,10,10"
                                Visibility="{Binding CanOpenIssueStaff, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OpenIssueStaffButton_OnClick" />

                        <Button Content="Open Issue (Manager)"
                                Width="190"
                                Height="38"
                                Margin="0,0,10,10"
                                Visibility="{Binding CanOpenIssueManager, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OpenIssueManagerButton_OnClick" />

                                
                                Visibility="{Binding CanOpenTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="OpenTransferButton_OnClick" />

                        <Button Content="Open Receipt (Staff)"
            Width="180"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanOpenReceiptStaff, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenReceiptStaffButton_OnClick" />

                        <Button Content="Open Receipt (Manager)"
            Width="200"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanOpenReceiptManager, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenReceiptManagerButton_OnClick" />

                        <Button Content="View Stock Snapshot"
            Width="180"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanViewStockSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenStockSnapshotButton_OnClick" />

                        <Button Content="View Stock Ledger"
            Width="170"
            Height="38"
            Margin="0,0,10,0"
            Visibility="{Binding CanViewStockLedger, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenStockLedgerButton_OnClick" />

                        <Button Content="View Expiry Alerts"
            Width="170"
            Height="38"
            Visibility="{Binding CanViewExpiryAlerts, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="OpenExpiryAlertsButton_OnClick" />



                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
<Window x:Class="SP26InventoryManagement.ReceiptStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Receipt Management - Warehouse Staff"
        Height="800"
        Width="1320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Receipt Management - Warehouse Staff"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PermissionSummary}"
                           Foreground="#444444" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Crimson"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Create Receipt Draft"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Width="220" Margin="0,0,10,0">
                        <TextBlock Text="Warehouse" />
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,10,0">
                        <TextBlock Text="Supplier (Optional)" />
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Transaction Date" />
                        <DatePicker SelectedDate="{Binding TransactionDate}"
                                    Height="30" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,10,0">
                        <TextBlock Text="Reference No" />
                        <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="330">
                        <TextBlock Text="Remarks" />
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Width="300" Margin="0,0,10,0">
                        <TextBlock Text="Product" />
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProductToAdd}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="Lot Code" />
                        <TextBox Text="{Binding AddLotCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,10,0">
                        <TextBlock Text="Qty" />
                        <TextBox Text="{Binding AddQtyInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="Unit Cost" />
                        <TextBox Text="{Binding AddUnitCostInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,0">
                        <TextBlock Text="Received Date" />
                        <DatePicker SelectedDate="{Binding AddReceivedDate}"
                                    Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,0">
                        <TextBlock Text="Expiry Date" />
                        <DatePicker SelectedDate="{Binding AddExpiryDate}"
                                    Height="30" />
                    </StackPanel>
                    <StackPanel Width="120">
                        <TextBlock Text=" " />
                        <Button Content="Add Line"
                                Command="{Binding AddLineCommand}"
                                Height="30" />
                    </StackPanel>
                </WrapPanel>

                <DataGrid ItemsSource="{Binding RequestLines}"
                          SelectedItem="{Binding SelectedRequestLine}"
                          AutoGenerateColumns="False"
                          Height="360"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU"
                                            Binding="{Binding Sku}"
                                            Width="120" />
                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding ProductName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Lot"
                                            Binding="{Binding LotCode}"
                                            Width="120" />
                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Qty, StringFormat=N3}"
                                            Width="90" />
                        <DataGridTextColumn Header="Unit Cost"
                                            Binding="{Binding UnitCost, StringFormat=N4}"
                                            Width="100" />
                        <DataGridTextColumn Header="Received"
                                            Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}"
                                            Width="100" />
                        <DataGridTextColumn Header="Expiry"
                                            Binding="{Binding ExpiryDisplay}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Remove Line"
                            Command="{Binding RemoveLineCommand}"
                            Width="120"
                            Margin="0,0,8,0" />
                    <Button Content="Clear Form"
                            Command="{Binding ClearReceiptFormCommand}"
                            Width="110"
                            Margin="0,0,8,0" />
                    <Button Content="Create Draft Receipt"
                            Command="{Binding CreateReceiptCommand}"
                            Width="160" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="SP26InventoryManagement.ReceiptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Receipt Management - Manager"
        Height="760"
        Width="1320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Receipt Management - Manager"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PermissionSummary}"
                           Foreground="#444444" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Crimson"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,8">
                    <TextBlock Text="Post Receipt"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right">
                        <Button Content="Refresh Drafts"
                                Command="{Binding RefreshDraftReceiptsCommand}"
                                Width="120"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel Selected Draft"
                                Command="{Binding CancelDraftReceiptCommand}"
                                Width="150"
                                Margin="0,0,8,0" />
                        <Button Content="Post Selected Receipt"
                                Command="{Binding PostReceiptCommand}"
                                Width="150" />
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{Binding DraftReceipts}"
                          SelectedItem="{Binding SelectedDraftReceipt}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,8,0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Doc No"
                                            Binding="{Binding TransactionNo}"
                                            Width="170" />
                        <DataGridTextColumn Header="Warehouse"
                                            Binding="{Binding WarehouseName}"
                                            Width="160" />
                        <DataGridTextColumn Header="Supplier"
                                            Binding="{Binding SupplierName}"
                                            Width="180" />
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}"
                                            Width="100" />
                        <DataGridTextColumn Header="Created By"
                                            Binding="{Binding CreatedBy}"
                                            Width="120" />
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding TotalAmount, StringFormat=N2}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding DraftReceiptLines}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="8,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Binding="{Binding LineNo}"
                                            Width="40" />
                        <DataGridTextColumn Header="SKU"
                                            Binding="{Binding Sku}"
                                            Width="110" />
                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding ProductName}"
                                            Width="170" />
                        <DataGridTextColumn Header="Lot"
                                            Binding="{Binding LotCode}"
                                            Width="100" />
                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Qty, StringFormat=N3}"
                                            Width="90" />
                        <DataGridTextColumn Header="Unit Cost"
                                            Binding="{Binding UnitCost, StringFormat=N4}"
                                            Width="100" />
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding LineAmount, StringFormat=N2}"
                                            Width="100" />
                        <DataGridTextColumn Header="Received"
                                            Binding="{Binding ReceivedDateSnapshot, StringFormat=yyyy-MM-dd}"
                                            Width="100" />
                        <DataGridTextColumn Header="Expiry"
                                            Binding="{Binding ExpiryDisplay}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="SP26InventoryManagement.AdminUserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin - User Management"
        Height="760"
        Width="1240"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="User Management"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Width="280" Margin="0,0,10,0">
                        <TextBlock Text="Search (username/full name)" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    </StackPanel>
                    <StackPanel Width="260" Margin="0,0,10,0">
                        <TextBlock Text="Role filter" />
                        <ComboBox ItemsSource="{Binding RoleFilterOptions}"
                                  SelectedItem="{Binding SelectedRoleFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,10,0">
                        <TextBlock Text="Status" />
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="140" VerticalAlignment="Bottom">
                        <Button Content="Search"
                                Command="{Binding SearchCommand}"
                                Height="30" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="70" />
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="220" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="150" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt}" Width="170" />
                        <DataGridTextColumn Header="Roles" Binding="{Binding RolesDisplay}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Actions"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Button Content="Create User"
                                Command="{Binding OpenCreateUserCommand}"
                                Height="32"
                                Margin="0,0,0,6" />
                        <Button Content="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                Height="32"
                                Margin="0,0,0,6" />
                        <Button Content="Deactivate User"
                                Command="{Binding DeactivateUserCommand}"
                                Height="32"
                                Margin="0,0,0,6" />
                        <Button Content="Reactivate User"
                                Command="{Binding ReactivateUserCommand}"
                                Height="32"
                                Margin="0,0,0,12" />
                        <Button Content="Change My Password"
                                Command="{Binding OpenChangePasswordCommand}"
                                Height="32"
                                Margin="0,0,0,12" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Assign Roles"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <Border BorderBrush="#E3E3E3"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6"
                                Height="290">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RoleSelections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Display}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,2,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Button Content="Save Roles"
                                Command="{Binding SaveRolesCommand}"
                                Height="32"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Crimson" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Prev"
                        Command="{Binding PreviousPageCommand}"
                        Width="80"
                        Margin="0,0,8,0" />
                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Next"
                        Command="{Binding NextPageCommand}"
                        Width="80" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

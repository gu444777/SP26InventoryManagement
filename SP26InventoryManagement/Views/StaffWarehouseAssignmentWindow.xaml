<Window x:Class="SP26InventoryManagement.StaffWarehouseAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin - Staff Warehouse Assignment"
        Height="760"
        Width="1220"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Staff Warehouse Assignment"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Width="320" Margin="0,0,10,0">
                        <TextBlock Text="Search (username/full name)" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,10,0">
                        <TextBlock Text="Status" />
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="140" VerticalAlignment="Bottom">
                        <Button Content="Search"
                                Command="{Binding SearchCommand}"
                                Height="30" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding StaffUsers}"
                          SelectedItem="{Binding SelectedStaffUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="70" />
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="220" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80" />
                        <DataGridTextColumn Header="Current Warehouse" Binding="{Binding CurrentWarehouseDisplay}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Assign / Change Warehouse"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Selected Staff"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2" />
                    <TextBlock Text="{Binding SelectedStaffUser.Username, TargetNullValue='(none)'}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Warehouse"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Display"
                              Height="32" />

                    <Button Content="Assign / Change Warehouse"
                            Command="{Binding AssignWarehouseCommand}"
                            Height="34"
                            Margin="0,12,0,0" />

                    <TextBlock Text="Direct unassign is not allowed for users who still have WAREHOUSE_STAFF role."
                               Foreground="DimGray"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Crimson"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Content="Prev"
                        Command="{Binding PreviousPageCommand}"
                        Width="80"
                        Margin="0,0,8,0" />
                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Next"
                        Command="{Binding NextPageCommand}"
                        Width="80" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

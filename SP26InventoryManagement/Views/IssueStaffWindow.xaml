<Window x:Class="SP26InventoryManagement.IssueStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Issue Management - Warehouse Staff"
        Height="820"
        Width="1320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Issue Management - Warehouse Staff"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PermissionSummary}"
                           Foreground="#444444" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Crimson"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Create Issue Draft"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <WrapPanel Margin="0,0,0,10">
                    <StackPanel Width="220" Margin="0,0,10,0">
                        <TextBlock Text="Warehouse" />
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,10,0">
                        <TextBlock Text="Customer (Optional)" />
                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Transaction Date" />
                        <DatePicker SelectedDate="{Binding TransactionDate}"
                                    Height="30" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,10,0">
                        <TextBlock Text="Reference No" />
                        <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="330">
                        <TextBlock Text="Remarks" />
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,0,0,6">
                    <StackPanel Width="420" Margin="0,0,10,0">
                        <TextBlock Text="Search Product" />
                        <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="Product" />
                        <ComboBox ItemsSource="{Binding FilteredProductsView}"
                                  SelectedItem="{Binding SelectedProductToAdd}"
                                  DisplayMemberPath="Display"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="Qty" />
                        <TextBox Text="{Binding AddQtyInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Unit Price (Opt.)" />
                        <TextBox Text="{Binding AddUnitPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="120">
                        <TextBlock Text=" " />
                        <Button Content="Add Line"
                                Command="{Binding AddLineCommand}"
                                Height="30" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding SelectedProductAvailableQtyText}"
                           Foreground="#2F4F4F"
                           Margin="0,0,0,10" />

                <DataGrid ItemsSource="{Binding RequestLines}"
                          SelectedItem="{Binding SelectedRequestLine}"
                          AutoGenerateColumns="False"
                          Height="170"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU"
                                            Binding="{Binding Sku}"
                                            Width="150" />
                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding ProductName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Qty, StringFormat=N3}"
                                            Width="100" />
                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat=N4}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Remove Line"
                            Command="{Binding RemoveLineCommand}"
                            Width="120"
                            Margin="0,0,8,0" />
                    <Button Content="Clear Form"
                            Command="{Binding ClearIssueFormCommand}"
                            Width="110"
                            Margin="0,0,8,0" />
                    <Button Content="Preview Allocation"
                            Command="{Binding PreviewAllocationCommand}"
                            Width="140"
                            Margin="0,0,8,0" />
                    <Button Content="Create Draft Issue"
                            Command="{Binding CreateIssueCommand}"
                            Width="150" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Preview Lot Allocation (FEFO/FIFO)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PreviewStatusMessage}"
                           Foreground="#444444"
                           Margin="0,0,0,8" />

                <DataGrid ItemsSource="{Binding PreviewAllocations}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Height="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU"
                                            Binding="{Binding Sku}"
                                            Width="120" />
                        <DataGridTextColumn Header="Product"
                                            Binding="{Binding ProductName}"
                                            Width="180" />
                        <DataGridTextColumn Header="Lot"
                                            Binding="{Binding LotCode}"
                                            Width="110" />
                        <DataGridTextColumn Header="Rule"
                                            Binding="{Binding AllocationRule}"
                                            Width="70" />
                        <DataGridTextColumn Header="Expiry"
                                            Binding="{Binding ExpiryDisplay}"
                                            Width="100" />
                        <DataGridTextColumn Header="Avail"
                                            Binding="{Binding AvailableQtyBeforeAllocation, StringFormat=N3}"
                                            Width="90" />
                        <DataGridTextColumn Header="Alloc Qty"
                                            Binding="{Binding AllocatedQty, StringFormat=N3}"
                                            Width="90" />
                        <DataGridTextColumn Header="Unit Cost"
                                            Binding="{Binding UnitCost, StringFormat=N4}"
                                            Width="100" />
                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat=N4}"
                                            Width="100" />
                        <DataGridTextColumn Header="COGS"
                                            Binding="{Binding CogsAmount, StringFormat=N2}"
                                            Width="110" />
                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding LineAmount, StringFormat=N2}"
                                            Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

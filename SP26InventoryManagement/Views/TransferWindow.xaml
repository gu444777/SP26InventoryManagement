<Window x:Class="SP26InventoryManagement.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transfer Management"
        Height="860"
        Width="1460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Transfer Management"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="{Binding PermissionSummary}"
                           Foreground="#444444" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Create Transfer">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Width="240" Margin="0,0,10,0">
                            <TextBlock Text="Source Warehouse" />
                            <ComboBox ItemsSource="{Binding SourceWarehouses}"
                                      SelectedItem="{Binding SelectedSourceWarehouse}"
                                      DisplayMemberPath="Display"
                                      IsEnabled="{Binding CanChooseSourceWarehouse}"
                                      Height="30" />
                        </StackPanel>
                        <StackPanel Width="240" Margin="0,0,10,0">
                            <TextBlock Text="Destination Warehouse" />
                            <ComboBox ItemsSource="{Binding DestinationWarehouses}"
                                      SelectedItem="{Binding SelectedDestinationWarehouse}"
                                      DisplayMemberPath="Display"
                                      Height="30" />
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,10,0">
                            <TextBlock Text="Request Date" />
                            <DatePicker SelectedDate="{Binding RequestDate}"
                                        Height="30" />
                        </StackPanel>
                        <StackPanel Width="170" Margin="0,0,10,0">
                            <TextBlock Text="Required Date" />
                            <DatePicker SelectedDate="{Binding RequiredDate}"
                                        Height="30" />
                        </StackPanel>
                        <StackPanel Width="360">
                            <TextBlock Text="Remarks" />
                            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel Margin="0,0,0,4">
                            <StackPanel Width="420" Margin="0,0,10,0">
                                <TextBlock Text="Search Product" />
                                <TextBox Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30"
                                         Margin="0,0,0,4" />
                                <TextBlock Text="Product" />
                                <ComboBox ItemsSource="{Binding FilteredProductsView}"
                                          SelectedItem="{Binding SelectedProductToAdd}"
                                          DisplayMemberPath="Display"
                                          Height="30" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,0">
                                <TextBlock Text="Qty" />
                                <TextBox Text="{Binding AddQtyInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="30" />
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text=" " />
                                <Button Content="Add Line"
                                        Command="{Binding AddLineCommand}"
                                        Height="30" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding SelectedProductAvailableQtyText}"
                                   Foreground="#2F4F4F" />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CreateLines}"
                              SelectedItem="{Binding SelectedCreateLine}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="170"
                              Margin="0,0,0,8"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding Sku}"
                                                Width="180" />
                            <DataGridTextColumn Header="Product"
                                                Binding="{Binding ProductName}"
                                                Width="*" />
                            <DataGridTextColumn Header="Requested Qty"
                                                Binding="{Binding RequestedQty, StringFormat=N3}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding PreviewLotAllocations}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding Sku}"
                                                Width="110"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Product"
                                                Binding="{Binding ProductName}"
                                                Width="160"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Source Lot"
                                                Binding="{Binding LotCode}"
                                                Width="110"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Rule"
                                                Binding="{Binding AllocationRule}"
                                                Width="70"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Received"
                                                Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}"
                                                Width="100"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Expiry"
                                                Binding="{Binding ExpiryDisplay}"
                                                Width="100"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Avail"
                                                Binding="{Binding AvailableQtyBeforeAllocation, StringFormat=N3}"
                                                Width="90"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Suggested"
                                                Binding="{Binding SuggestedQty, StringFormat=N3}"
                                                Width="90"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Selected Qty"
                                                Binding="{Binding SelectedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                Width="110" />
                            <DataGridTextColumn Header="Unit Cost"
                                                Binding="{Binding UnitCost, StringFormat=N4}"
                                                Width="100"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{Binding CreateStatusMessage}"
                                   Foreground="#444444"
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Remove Line"
                                    Command="{Binding RemoveLineCommand}"
                                    Width="120"
                                    Margin="0,0,8,0" />
                            <Button Content="Clear Form"
                                    Command="{Binding ClearCreateFormCommand}"
                                    Width="110"
                                    Margin="0,0,8,0" />
                            <Button Content="Preview Suggestion"
                                    Command="{Binding PreviewSuggestionCommand}"
                                    Width="150"
                                    Margin="0,0,8,0" />
                            <Button Content="Create Transfer"
                                    Command="{Binding CreateTransferCommand}"
                                    Width="130" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Source Dispatch">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,8">
                        <TextBlock Text="{Binding DispatchStatusMessage}"
                                   Foreground="#444444"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshSourceDispatchQueueCommand}"
                                    Width="100"
                                    Margin="0,0,8,0" />
                            <Button Content="Cancel Draft"
                                    Command="{Binding CancelCreatedTransferCommand}"
                                    Width="120"
                                    Margin="0,0,8,0" />
                            <Button Content="Confirm Dispatch"
                                    Command="{Binding ConfirmSourceDispatchCommand}"
                                    Width="140" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              Grid.Column="0"
                              ItemsSource="{Binding SourceDispatchQueue}"
                              SelectedItem="{Binding SelectedSourceDispatchTransfer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,0,8,0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transfer No"
                                                Binding="{Binding TransferNo}"
                                                Width="160" />
                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding SourceWarehouseName}"
                                                Width="150" />
                            <DataGridTextColumn Header="Destination"
                                                Binding="{Binding DestinationWarehouseName}"
                                                Width="150" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding RequestDate, StringFormat=yyyy-MM-dd}"
                                                Width="100" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding TransferStatus}"
                                                Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding SourceDispatchDetailLines}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding LineNo}"
                                                    Width="40" />
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding Sku}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding ProductName}"
                                                    Width="180" />
                                <DataGridTextColumn Header="Requested"
                                                    Binding="{Binding RequestedQty, StringFormat=N3}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Dispatched"
                                                    Binding="{Binding DispatchedQty, StringFormat=N3}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Received"
                                                    Binding="{Binding ReceivedQty, StringFormat=N3}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SourceDispatchDetailLots}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line"
                                                    Binding="{Binding LineNo}"
                                                    Width="50" />
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding Sku}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Lot"
                                                    Binding="{Binding LotCode}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Expiry"
                                                    Binding="{Binding ExpiryDisplay}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding DispatchedQty, StringFormat=N3}"
                                                    Width="90" />
                                <DataGridTextColumn Header="Unit Cost"
                                                    Binding="{Binding UnitCost, StringFormat=N4}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Destination Receipt">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,8">
                        <TextBlock Text="{Binding ReceiptStatusMessage}"
                                   Foreground="#444444"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshDestinationReceiptQueueCommand}"
                                    Width="100"
                                    Margin="0,0,8,0" />
                            <Button Content="Confirm Receipt"
                                    Command="{Binding ConfirmDestinationReceiptCommand}"
                                    Width="140" />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              Grid.Column="0"
                              ItemsSource="{Binding DestinationReceiptQueue}"
                              SelectedItem="{Binding SelectedDestinationReceiptTransfer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,0,8,0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transfer No"
                                                Binding="{Binding TransferNo}"
                                                Width="160" />
                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding SourceWarehouseName}"
                                                Width="150" />
                            <DataGridTextColumn Header="Destination"
                                                Binding="{Binding DestinationWarehouseName}"
                                                Width="150" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding RequestDate, StringFormat=yyyy-MM-dd}"
                                                Width="100" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding TransferStatus}"
                                                Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding DestinationReceiptDetailLines}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding LineNo}"
                                                    Width="40" />
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding Sku}"
                                                    Width="120" />
                                <DataGridTextColumn Header="Product"
                                                    Binding="{Binding ProductName}"
                                                    Width="180" />
                                <DataGridTextColumn Header="Requested"
                                                    Binding="{Binding RequestedQty, StringFormat=N3}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Dispatched"
                                                    Binding="{Binding DispatchedQty, StringFormat=N3}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Received"
                                                    Binding="{Binding ReceivedQty, StringFormat=N3}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DestinationReceiptDetailLots}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line"
                                                    Binding="{Binding LineNo}"
                                                    Width="50" />
                                <DataGridTextColumn Header="SKU"
                                                    Binding="{Binding Sku}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Lot"
                                                    Binding="{Binding LotCode}"
                                                    Width="110" />
                                <DataGridTextColumn Header="Dest Lot Id"
                                                    Binding="{Binding DestinationProductLotId}"
                                                    Width="100" />
                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding ReceivedQty, StringFormat=N3}"
                                                    Width="90" />
                                <DataGridTextColumn Header="Unit Cost"
                                                    Binding="{Binding UnitCost, StringFormat=N4}"
                                                    Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

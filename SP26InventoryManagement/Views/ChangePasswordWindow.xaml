<Window x:Class="SP26InventoryManagement.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password"
        Height="360"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Username, StringFormat='Change password for: {0}'}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <TextBlock Grid.Row="1" Text="Current password" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="2"
                     Height="32"
                     PasswordChanged="CurrentPasswordBox_OnPasswordChanged" />

        <TextBlock Grid.Row="3" Text="New password" Margin="0,12,0,4" />
        <PasswordBox Grid.Row="4"
                     Height="32"
                     PasswordChanged="NewPasswordBox_OnPasswordChanged" />

        <TextBlock Grid.Row="5" Text="Confirm password" Margin="0,12,0,4" />
        <PasswordBox Grid.Row="6"
                     Height="32"
                     PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />

        <StackPanel Grid.Row="7" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Crimson"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        MinWidth="90"
                        Margin="0,0,10,0" />
                <Button Content="Change"
                        Command="{Binding ChangePasswordCommand}"
                        MinWidth="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

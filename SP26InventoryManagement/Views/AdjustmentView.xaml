<Window x:Class="SP26InventoryManagement.Views.AdjustmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment &amp; Confirmation" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="STOCK ADJUSTMENT MANAGEMENT" FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Foreground="#2C3E50" Margin="0,0,0,25"/>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="5" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Create New Adjustment" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2980B9"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,15,0,0">
                    <Button Content="Submit (Save Draft)" Command="{Binding SubmitCommand}" 
                            Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Transaction No:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TransactionHeader.TransactionNo}" IsReadOnly="True" 
                                 Background="#F0F3F4" Margin="0,5,0,12" Padding="6"/>

                        <TextBlock Text="Category:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding TransactionTypes}" 
                                  SelectedItem="{Binding SelectedType}" 
                                  Margin="0,5,0,12" Padding="6"/>

                        <TextBlock Text="Warehouse:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" 
                                  DisplayMemberPath="WarehouseName" 
                                  SelectedValuePath="WarehouseId" 
                                  SelectedValue="{Binding SelectedWarehouseId}" 
                                  Margin="0,5,0,12" Padding="6"/>

                        <TextBlock Text="Product:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Products}" 
                                  DisplayMemberPath="ProductName" 
                                  SelectedValuePath="ProductId" 
                                  SelectedValue="{Binding SelectedProductId}" 
                                  Margin="0,5,0,12" Padding="6"/>

                        <TextBlock Text="Lot Number:" FontWeight="SemiBold" Foreground="#E74C3C"/>
                        <ComboBox ItemsSource="{Binding ProductLots}" 
                                  SelectedItem="{Binding SelectedLot}" 
                                  DisplayMemberPath="LotCode" 
                                  Margin="0,5,0,2" Padding="6" BorderBrush="#E74C3C"/>
                        <TextBlock Text="{Binding SelectedLot.ExpiryDate, StringFormat='Expiry: {0:dd/MM/yyyy}'}" 
                                   FontSize="10" Foreground="#7F8C8D" Margin="5,0,0,12"/>

                        <TextBlock Text="Quantity:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding InputQty, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,5,0,12" Padding="6"/>

                        <TextBlock Text="Reason:" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ReasonInput, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                 Margin="0,5,0,5" Padding="6"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="5" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pending Confirmations (OPEN)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#D35400"/>

                <DataGrid ItemsSource="{Binding UnpostedTransactions}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          Background="White"
                          RowHeight="40"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F2F4F4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Trans No" Binding="{Binding TransactionNo}" Width="130"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="100"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=\{0:dd/MM/yy HH:mm\}}" Width="110"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding AdjustmentReason}" Width="*"/>

                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Confirm" 
                                            Command="{Binding DataContext.PostCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="#E67E22" Foreground="White" 
                                            FontWeight="Bold" Cursor="Hand"
                                            Margin="5,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
<Window x:Class="SP26InventoryManagement.StockLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stock Ledger"
        Height="800"
        Width="1560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Stock Ledger"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Text="Chronological inventory movement history for posted transactions."
                           Foreground="#444444"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#444444" />

                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="250" Margin="0,0,10,0">
                        <TextBlock Text="Warehouse" />
                        <ComboBox ItemsSource="{Binding WarehouseFilters}"
                                  SelectedItem="{Binding SelectedWarehouseFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="300" Margin="0,0,10,0">
                        <TextBlock Text="Product" />
                        <ComboBox ItemsSource="{Binding ProductFilters}"
                                  SelectedItem="{Binding SelectedProductFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,0">
                        <TextBlock Text="Movement" />
                        <ComboBox ItemsSource="{Binding MovementFilters}"
                                  SelectedItem="{Binding SelectedMovementFilter}"
                                  Height="30" />
                    </StackPanel>
                    <StackPanel Width="260" Margin="0,0,10,0">
                        <TextBlock Text="Search" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30" />
                    </StackPanel>
                    <StackPanel Width="120">
                        <TextBlock Text=" " />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Height="30" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DataGrid ItemsSource="{Binding FilteredEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Txn Date"
                                        Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd HH:mm}"
                                        Width="130" />
                    <DataGridTextColumn Header="Posted At"
                                        Binding="{Binding PostedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                        Width="130" />
                    <DataGridTextColumn Header="Transaction No"
                                        Binding="{Binding TransactionNo}"
                                        Width="150" />
                    <DataGridTextColumn Header="Movement"
                                        Binding="{Binding MovementDisplay}"
                                        Width="85" />
                    <DataGridTextColumn Header="Warehouse"
                                        Binding="{Binding WarehouseDisplay}"
                                        Width="180" />
                    <DataGridTextColumn Header="SKU"
                                        Binding="{Binding Sku}"
                                        Width="110" />
                    <DataGridTextColumn Header="Product"
                                        Binding="{Binding ProductName}"
                                        Width="180" />
                    <DataGridTextColumn Header="Lot"
                                        Binding="{Binding LotCode}"
                                        Width="110" />
                    <DataGridTextColumn Header="Received"
                                        Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}"
                                        Width="100" />
                    <DataGridTextColumn Header="Expiry"
                                        Binding="{Binding ExpiryDisplay}"
                                        Width="100" />
                    <DataGridTextColumn Header="Qty In"
                                        Binding="{Binding QtyIn, StringFormat=N3}"
                                        Width="90" />
                    <DataGridTextColumn Header="Qty Out"
                                        Binding="{Binding QtyOut, StringFormat=N3}"
                                        Width="90" />
                    <DataGridTextColumn Header="Net Qty"
                                        Binding="{Binding SignedQty, StringFormat=N3}"
                                        Width="90" />
                    <DataGridTextColumn Header="Unit Cost"
                                        Binding="{Binding UnitCost, StringFormat=N4}"
                                        Width="90" />
                    <DataGridTextColumn Header="Unit Price"
                                        Binding="{Binding UnitPrice, StringFormat=N4}"
                                        Width="90" />
                    <DataGridTextColumn Header="Amount"
                                        Binding="{Binding LineAmount, StringFormat=N2}"
                                        Width="90" />
                    <DataGridTextColumn Header="COGS"
                                        Binding="{Binding CogsAmount, StringFormat=N2}"
                                        Width="90" />
                    <DataGridTextColumn Header="Reference"
                                        Binding="{Binding ReferenceNo}"
                                        Width="120" />
                    <DataGridTextColumn Header="Counterparty"
                                        Binding="{Binding CounterpartyName}"
                                        Width="160" />
                    <DataGridTextColumn Header="Created By"
                                        Binding="{Binding CreatedBy}"
                                        Width="100" />
                    <DataGridTextColumn Header="Posted By"
                                        Binding="{Binding PostedBy}"
                                        Width="100" />
                    <DataGridTextColumn Header="Remarks"
                                        Binding="{Binding Remarks}"
                                        Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

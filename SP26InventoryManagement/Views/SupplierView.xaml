<Window x:Class="SP26InventoryManagement.Views.SupplierView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier Management"
        Height="550" Width="1000"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="🏢 Supplier Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0 0 0 20"/>

        <!-- FORM -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock Text="Supplier Name"/>
                    <TextBox Height="35"
                             Text="{Binding Form.SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phone" Margin="0 10 0 0"/>
                    <TextBox Height="35"
                             Text="{Binding Form.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="1" Margin="10">
                    <TextBlock Text="Email"/>
                    <TextBox Height="35"
                             Text="{Binding Form.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Address" Margin="0 10 0 0"/>
                    <TextBox Height="35"
                             Text="{Binding Form.AddressLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10">

                    <Button Content="➕ Add"
                            Command="{Binding AddCommand}"
                            Background="#27AE60"
                            Style="{StaticResource ModernButton}"/>

                    <Button Content="🗑 Delete"
                            Command="{Binding DeleteCommand}"
                            Background="#E74C3C"
                            Style="{StaticResource ModernButton}"/>

                    <Button Content="✏️ Update"
                            Command="{Binding UpdateCommand}"
                            Background="#F39C12"
                            Style="{StaticResource ModernButton}"/>

                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="Crimson"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"
                   TextWrapping="Wrap"/>

        <!-- TABLE -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="10">
            <DataGrid ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      RowHeight="40"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      IsReadOnly="True"
                      SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding SupplierCode}" Width="120"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding SupplierName}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="150"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding AddressLine}" Width="250"/>
                    <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/>
                    <DataGridTextColumn Header="Updated At" Binding="{Binding UpdatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="170"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>
</Window>
